{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Attention Hub",
  "version": "0.6.0-beta.9",
  "identifier": "com.attentionhub.desktop",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Attention Hub",
        "width": 548,
        "height": 60,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "shadow": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "resources": {
      "../sounds/meeting-start.wav": "sounds/meeting-start.wav"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI5MDQyNDBGMzBDMTkwMEEKUldRS2tNRXdEeVFFdVZnSG5aRjQrc0F1ZlEzMkZ0VWZIQnZ6VG5qWjh5UFdtb3l3L3ZwMDRSWi8K",
      "endpoints": [
        "https://raw.githubusercontent.com/dersmoll/attention-hub/updater-feed/latest-beta.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
